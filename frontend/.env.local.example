# URL of the Laravel API from part (a) — no trailing slash, /api is appended by src/lib/api.ts
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Live tracking — must match the API's REVERB_APP_KEY/HOST/PORT/SCHEME exactly
NEXT_PUBLIC_REVERB_APP_KEY=domexpress-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
