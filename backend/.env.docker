# Comma-separated list of allowed frontend origins (read by config/cors.php)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Live tracking (Laravel Reverb — self-hosted WebSocket server)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ITEA3express
REVERB_APP_KEY=57db02062228a6f7503a78b7516182c3
REVERB_APP_SECRET=cf820b76ed00088ba3ad34a3fd458c2791dabb97c75ca8e84d2ad37e8021e482
# REVERB_HOST/PORT/SCHEME = what the BROWSER connects to (public-facing).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# REVERB_SERVER_HOST/PORT = what the Reverb process itself binds to inside the container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Set to true once, then back to false after the first run if you don't want
# demo data re-seeded on every container restart.
RUN_SEEDER=true

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

ROUTING_URL=https://router.project-osrm.org
ROUTE_ETA_FACTOR=1.3
ROUTING_URL=http://osrm:5000
GOOGLE_CLIENT_ID=
