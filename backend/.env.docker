APP_NAME=ITEA3express
APP_ENV=production
APP_KEY=base64:m1m2hc6mqq9uKk86913ZLJoxCcv3TozPDQh2FwDd2y4=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
