APP_NAME=DomExpress
APP_ENV=production
APP_KEY=base64:GENERATE_ME
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=domexpress
DB_USERNAME=domexpress
DB_PASSWORD=change_me

# Comma-separated list of allowed frontend origins (read by config/cors.php)
FRONTEND_URL=http://localhost:3000

# Live tracking (Laravel Reverb — self-hosted WebSocket server)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=domexpress
REVERB_APP_KEY=domexpress-key
REVERB_APP_SECRET=change_me_reverb_secret
# REVERB_HOST/PORT/SCHEME = what the BROWSER connects to (public-facing).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# REVERB_SERVER_HOST/PORT = what the Reverb process itself binds to inside the container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Set to true once, then back to false after the first run if you don't want
# demo data re-seeded on every container restart.
RUN_SEEDER=true

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
